CT_CONFIG_VERSION="4"
CT_PREFIX_DIR="${TOOLCHAINS}/${CT_TARGET}"
# CT_PREFIX_DIR_RO is not set
CT_ARCH_ARM=y
CT_ARCH_CPU="cortex-a8"
CT_ARCH_FPU="neon"
CT_ARCH_FLOAT_HW=y
CT_TARGET_VENDOR="nest"
CT_KERNEL_LINUX=y
CT_LINUX_V_2_6_32=y
CT_BINUTILS_V_2_26=y
CT_GLIBC_V_2_19=y
CT_GCC_V_4_9=y
CT_CC_LANG_CXX=y
